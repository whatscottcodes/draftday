# Backend (Render + local uvicorn). Set these in the shell environment.
# Required for any commissioner/admin action (create league, list drafts,
# open admin/keeper consoles). Without it the admin endpoints return 503.
ADMIN_PASSCODE=change-me-to-a-long-random-string
# PostgreSQL Session Pooler URL (draftday-backend on Render uses this).
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Frontend (Vercel + local next dev). Next.js reads NEXT_PUBLIC_* from
# frontend/.env.local (gitignored).
# NEXT_PUBLIC_API_URL=https://draftday-backend.onrender.com